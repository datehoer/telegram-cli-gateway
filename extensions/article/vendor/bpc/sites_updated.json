{
  "Bild der Wissenschaft": {
    "domain": "wissenschaft.de",
    "remove_cookies_select_drop": ["pw_session"],
    "upd_version": "4.4.5.2"
  },
  "Corriere dello Sport": {
    "domain": "corrieredellosport.it",
    "allow_cookies": 1,
    "amp_redirect": "div[class^='Paywall_section__']",
    "upd_version": "4.4.5.7"
  },
  "Deccan Herald": {
    "domain": "deccanherald.com",
    "allow_cookies": 1,
    "amp_redirect": "div.paywall",
    "upd_version": "4.4.5.3"
  },
  "Jacobin.de": {
    "domain": "jacobin.de",
    "allow_cookies": 1,
    "ld_archive_is": "aside.paywall|article|article|main",
    "upd_version": "4.4.5.2"
  },
  "Mediahuis Ireland": {
    "domain": "###_ie_mediahuis",
    "group": [
      "belfasttelegraph.co.uk",
      "independent.ie"
    ],
    "allow_cookies": 1,
    "ld_archive_is": "div#flip-pay:not(:empty)|article section",
    "upd_version": "4.4.5.7"
  },
  "National Review": {
    "domain": "nationalreview.com",
    "remove_cookies_select_drop": ["nr_premium_views"],
    "cs_block": 1,
    "upd_version": "4.4.5.1"
  },
  "The Daily Beast": {
    "domain": "thedailybeast.com",
    "allow_cookies": 1,
    "block_regex": "\\.thedailybeast\\.com\\/zephr\\/",
    "upd_version": "4.4.5.6"
  },
  "The Economist": {
    "domain": "economist.com",
    "allow_cookies": 1,
    "block_regex": "(\\/zephr\\/feature|\\.economist\\.com\\/(latest\\/wall-ui|script)\\.js)",
    "add_ext_link": "div#tp-regwall|main p[data-component='paragraph']",
    "add_ext_link_type": "google_search_tool",
    "cs_code": [{"set_attrib":"style|overflow: visible !important"}],
    "upd_version": "4.4.5.5"
  },
  "The Quint": {
    "domain": "thequint.com",
    "allow_cookies": 1,
    "amp_redirect": "div#paywall-widget|/amp/story{path}",
    "cs_code": [{"cond":"div.qt-amp-story-container-class", "rm_class":"qt-amp-story-container-class"}, {"hide_elem":"div.paywall-card"}],
    "upd_version": "4.4.5.8"
  },
  "The Spectator Group": {
    "domain": "###_uk_spectator",
    "group": [
      "spectator.com",
      "spectator.com.au",
      "apollo-magazine.com"
    ],
    "allow_cookies": 1,
    "block_regex": "\\.piano\\.io",
    "upd_version": "4.4.5.4"
  }
