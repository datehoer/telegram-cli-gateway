# Copy to .env, or run: ./scripts/import-openclaw-config.py
TELEGRAM_BOT_TOKEN=
# 可选：添加任意非空的 TELEGRAM_BOT_TOKEN_<名称> 后自动启用更多入口，无需开关。
# 后缀会作为持久状态中的 Bot 标识，配置后请保持稳定。
TELEGRAM_BOT_TOKEN_2=
# TELEGRAM_BOT_TOKEN_RESEARCH=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_GROUPS=false

DEFAULT_WORKDIR=/srv/projects
ALLOWED_WORKDIRS=/srv/projects

CLI_CLAUDE=claude
CLI_CODEX=codex
CLI_GROK=grok
CLI_PI=pi
# 可选：未在会话中用 /model、/effort 覆盖时采用的网关默认值
DEFAULT_CODEX_MODEL=gpt-6-astra
DEFAULT_CODEX_EFFORT=high
# 可选：限制此网关实例允许创建的 CLI，会同时避免启动未启用的 Codex app-server
ENABLED_CLIS=claude,codex,grok,pi

TELEGRAM_POLL_TIMEOUT=10
OUTPUT_POLL_INTERVAL=1.0
OUTPUT_MAX_BYTES=65536
STREAM_UPDATE_INTERVAL=10
# 单次发送上限。Telegram Bot API：sendDocument/sendVideo 上传 50MB、sendPhoto 10MB。
# 默认 45MB（=45*1024*1024），留 5MB 余量。超过上限的产物不会被自动发送，
# 卡片上只给一个回本机路径的按钮。
TELEGRAM_MAX_FILE_BYTES=47185920
# 发送 1 GiB 文件需要先部署本地 Bot API 服务（--local），见 docs/local-bot-api.md。
# TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081
# TELEGRAM_MAX_FILE_BYTES=1073741824
# 网关重启后是否自动恢复被中断的任务；false 时收到提示后用 /resume 手动恢复
AUTO_RESUME=false
# 可选：额外的直连命令扩展目录，必须在 ALLOWED_WORKDIRS 内。
# 仓库内的 extensions/ 始终会被扫描，不需要配置这一项。
# COMMAND_DIR=/srv/projects/my-commands
# 回答完成后是否自动发送 CLI 产物：off（默认，仅按钮）| images（只自动发图片）| all（图片+文件）
AUTO_SEND_ARTIFACTS=off
TMUX_SOCKET_NAME=telegram-cli-gateway
