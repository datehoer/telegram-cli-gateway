# Copy to .env, or run: ./scripts/import-openclaw-config.py
TELEGRAM_BOT_TOKEN=
# Optional: any non-empty TELEGRAM_BOT_TOKEN_<NAME> enables another bot entrance; no switch needed.
# The suffix is the bot's key in persistent state, so keep it stable once configured.
TELEGRAM_BOT_TOKEN_2=
# TELEGRAM_BOT_TOKEN_RESEARCH=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_GROUPS=false

DEFAULT_WORKDIR=/srv/projects
ALLOWED_WORKDIRS=/srv/projects

CLI_CLAUDE=claude
CLI_CODEX=codex
CLI_GROK=grok
CLI_PI=pi
# Optional: gateway defaults used when a session has not overridden them with /model or /effort
DEFAULT_CODEX_MODEL=gpt-6-astra
DEFAULT_CODEX_EFFORT=high
# Optional: limit the CLIs this gateway may create; a disabled Codex app-server is never started
ENABLED_CLIS=claude,codex,grok,pi

TELEGRAM_POLL_TIMEOUT=10
STREAM_UPDATE_INTERVAL=10
# Per-file send limit. Telegram Bot API: sendDocument/sendVideo upload 50 MB, sendPhoto 10 MB.
# The default 45 MB (45*1024*1024) leaves 5 MB of margin. Larger artifacts are never sent
# automatically; their card only offers a button that returns the local path.
TELEGRAM_MAX_FILE_BYTES=47185920
# Sending 1 GiB files needs a local Bot API server (--local) first; see docs/local-bot-api.md.
# TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081
# TELEGRAM_MAX_FILE_BYTES=1073741824
# Resume interrupted tasks automatically after a gateway restart; with false, reply /resume to the prompt
AUTO_RESUME=false
# Optional: an extra directory of direct command extensions, inside ALLOWED_WORKDIRS.
# The repository's extensions/ is always scanned and needs no setting.
# COMMAND_DIR=/srv/projects/my-commands
# Send CLI artifacts automatically after an answer: off (default, buttons only) | images | all (images and files)
AUTO_SEND_ARTIFACTS=off
# Language of the gateway's Telegram messages and menus: en (default) or zh.
# Extensions receive it as TG_LANGUAGE. Logs and prompts sent to the CLIs stay English.
GATEWAY_LANGUAGE=en
