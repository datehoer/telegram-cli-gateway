# Copy to .env, or run: ./scripts/import-openclaw-config.py
TELEGRAM_BOT_TOKEN=
# 可选：添加任意非空的 TELEGRAM_BOT_TOKEN_<名称> 后自动启用更多入口，无需开关。
# 后缀会作为持久状态中的 Bot 标识，配置后请保持稳定。
TELEGRAM_BOT_TOKEN_2=
# TELEGRAM_BOT_TOKEN_RESEARCH=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_GROUPS=false

DEFAULT_WORKDIR=/srv/projects
ALLOWED_WORKDIRS=/srv/projects

CLI_CLAUDE=claude
CLI_CODEX=codex
CLI_GROK=grok
CLI_PI=pi
# 可选：限制此网关实例允许创建的 CLI，会同时避免启动未启用的 Codex app-server
ENABLED_CLIS=claude,codex,grok,pi

TELEGRAM_POLL_TIMEOUT=10
OUTPUT_POLL_INTERVAL=1.0
OUTPUT_MAX_BYTES=65536
STREAM_UPDATE_INTERVAL=10
TELEGRAM_MAX_FILE_BYTES=20971520
# 网关重启后是否自动恢复被中断的任务；false 时收到提示后用 /resume 手动恢复
AUTO_RESUME=false
# 回答完成后是否自动发送 CLI 产物：off | images（默认，只自动发图片）| all（图片+文件）
AUTO_SEND_ARTIFACTS=images
TMUX_SOCKET_NAME=telegram-cli-gateway
